{
  "manifest_version": 3,
  "name": "PokerNow Hand Alert",
  "version": "1.1.0",
  "description": "PokerNow 테이블에서 내 홀카드를 읽어 화면 오버레이로 현재 패/프리미엄/내 차례/콜 정보를 보여줍니다. (감지·표시 전용, 자동 액션 없음)",

  "permissions": ["storage"],

  "host_permissions": [
    "https://www.pokernow.club/*",
    "https://pokernow.club/*",
    "https://www.pokernow.com/*",
    "https://pokernow.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "PokerNow Hand Alert",
    "default_icon": { "128": "icon128.png" }
  },

  "options_page": "options.html",

  "icons": { "128": "icon128.png" },

  "content_scripts": [
    {
      "matches": [
        "https://www.pokernow.club/*",
        "https://pokernow.club/*",
        "https://www.pokernow.com/*",
        "https://pokernow.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
